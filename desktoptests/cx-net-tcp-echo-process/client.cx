// A TCP client that sends five lines of three bytes, one at a time, to the
// echo server on 127.0.0.1:47301 and waits for each echo, through the
// batched net library.

package main

import "sys/net"

var buffer [64]ui8

func main() {
	global buffer
	var conn i32 = net.TCPDial("127.0.0.1", 47301)
	var count i32
	var handle i32
	var trigger i32
	var message i32
	var detail i32
	var length i32
	var queued i32
	var received i32
	var sent i32
	var updates i32
	var i i32
	for sent < 6 && updates < 500 {
		count = net.Update(100)
		updates++
		for i = 0; i < count; i++ {
			handle, trigger, message, detail = net.ReadyNext()
			if trigger == net.TriggerError {
				printf("error %d\n", detail)
				updates = 500
			}
			if trigger == net.TriggerData {
				length = net.Read(conn, message, buffer, 0)
				received = received + length
			}
			if trigger == net.TriggerConnected || trigger == net.TriggerData {
				if received == sent*3 && sent > 0 {
					printf("line %d echoed\n", sent)
				}
				if received == sent*3 && sent < 5 {
					buffer[0] = 76UB
					buffer[1] = i32.ui8(49 + sent)
					buffer[2] = 10UB
					queued = net.Write(conn, buffer, 3)
					sent++
				} else if received == sent*3 {
					sent++
				}
			}
		}
	}
	printf("received %d bytes\n", received)
	var closed bool = net.Close(conn)
	if closed == false {
		printf("close failed\n")
	}
}
